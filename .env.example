# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
# Runtime environment: development | production | test
NODE_ENV=development

# Port the Fastify server listens on
PORT=3000

# API version prefix
API_VERSION=v1

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://chainloyalty:chainloyalty@localhost:5432/chainloyalty

# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────
# Redis connection string
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────
# 256-bit random secret for signing JWTs — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_256_bit_random_string

# JWT expiry in hours
JWT_EXPIRY_HOURS=24

# Secret used to generate deterministic referral codes — generate with: openssl rand -hex 32
REFERRAL_SECRET=replace_with_256_bit_random_string

# ─────────────────────────────────────────────
# Admin
# ─────────────────────────────────────────────
# Secret header value required to access /v1/admin/* routes
ADMIN_SECRET=replace_with_admin_secret

# ─────────────────────────────────────────────
# Blockchain
# ─────────────────────────────────────────────
# RPC URL for Sepolia testnet (get from Infura or Alchemy)
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Private key of the wallet that will call mint() on the BadgeNFT contract
# NEVER commit this value — keep it only in .env
DEPLOYER_PRIVATE_KEY=replace_with_wallet_private_key

# Deployed BadgeNFT contract address (filled after Phase 10 deployment)
BADGE_NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Set to true to enable on-chain badge minting via the BadgeNFT contract
BLOCKCHAIN_MINTING_ENABLED=false

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
# Max events per minute per API key
RATE_LIMIT_EVENTS_PER_MIN=1000

# Max auth requests per minute per IP
RATE_LIMIT_AUTH_PER_MIN=20

# ─────────────────────────────────────────────
# Webhooks
# ─────────────────────────────────────────────
# HMAC-SHA256 signing secret for outbound webhook payloads
WEBHOOK_SECRET=replace_with_webhook_secret

# Timeout in milliseconds for outbound webhook HTTP calls
WEBHOOK_TIMEOUT_MS=5000

# ─────────────────────────────────────────────
# Rules Engine
# ─────────────────────────────────────────────
# Path to the rules configuration JSON file (relative to apps/api)
RULES_CONFIG_PATH=./src/config/rules.config.json

# Maximum points a single formula evaluation can produce (overflow protection)
FORMULA_MAX_POINTS=100000
