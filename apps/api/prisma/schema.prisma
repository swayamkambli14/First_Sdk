generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Companies — seller/business accounts that use ChainLoyalty
// ─────────────────────────────────────────────────────────────────────────────
model Company {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @db.VarChar(255)
  email           String   @unique @db.VarChar(255)
  passwordHash    String   @db.VarChar(255)       // bcrypt hash
  // Profile
  logoUrl         String?  @db.Text
  website         String?  @db.VarChar(255)
  industry        String?  @db.VarChar(100)
  description     String?  @db.Text
  // Contact
  contactName     String?  @db.VarChar(255)
  contactPhone    String?  @db.VarChar(30)
  country         String?  @db.VarChar(100)
  timezone        String   @default("UTC") @db.VarChar(50)
  // Plan
  plan            String   @default("free") @db.VarChar(20)  // free | starter | pro | enterprise
  planExpiresAt   DateTime? @db.Timestamptz
  // API Key (stored for dashboard use — raw key shown once, hash stored)
  apiKeyHash      String?  @db.VarChar(255)
  apiKeyPrefix    String?  @db.VarChar(10)
  apiKeyCreatedAt DateTime? @db.Timestamptz
  // Status
  isActive        Boolean  @default(true)
  emailVerified   Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz
  updatedAt       DateTime @updatedAt @db.Timestamptz

  apps     App[]
  sessions CompanySession[]

  @@index([email])
  @@map("companies")
}

// ─────────────────────────────────────────────────────────────────────────────
// Company Sessions — dashboard login sessions (JWT alternative for web)
// ─────────────────────────────────────────────────────────────────────────────
model CompanySession {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @db.Uuid
  tokenHash   String   @unique @db.VarChar(255)  // hashed session token
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.Text
  expiresAt   DateTime @db.Timestamptz
  createdAt   DateTime @default(now()) @db.Timestamptz

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([expiresAt])
  @@map("company_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Custodial Wallets — server-managed wallets for non-crypto users
// ─────────────────────────────────────────────────────────────────────────────
model CustodialWallet {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @unique @db.Uuid          // links to UserAccount
  address      String    @unique @db.VarChar(42)   // Ethereum address (plaintext)
  encryptedKey String    @db.Text                  // AES-256-GCM encrypted private key
  iv           String    @db.VarChar(64)            // initialization vector (hex)
  authTag      String    @db.VarChar(64)            // GCM auth tag (hex)
  walletType   String    @default("custodial") @db.VarChar(20) // "custodial" | "self_custody"
  createdAt    DateTime  @default(now()) @db.Timestamptz
  lastUsedAt   DateTime? @db.Timestamptz

  userAccount UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("custodial_wallets")
}

// ─────────────────────────────────────────────────────────────────────────────
// UserAccounts — unified identity for both custodial and web3 users
// ─────────────────────────────────────────────────────────────────────────────
model UserAccount {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String?  @unique @db.VarChar(255)  // custodial users
  passwordHash  String?  @db.VarChar(255)          // bcrypt hash for email auth
  googleId      String?  @unique @db.VarChar(255)  // Google OAuth
  walletAddress String   @unique @db.VarChar(42)   // always present
  walletMode    String   @default("custodial") @db.VarChar(20) // "custodial" | "web3"
  displayName   String?  @db.VarChar(255)
  avatarUrl     String?  @db.Text
  onboardingComplete Boolean @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  custodialWallet CustodialWallet?

  @@index([email])
  @@index([walletAddress])
  @@map("user_accounts")
}


model App {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String?  @db.Uuid                  // nullable for backward compat
  name         String   @db.VarChar(255)
  // Bcrypt hash of the API key — raw key is NEVER stored
  apiKeyHash   String   @unique @db.VarChar(255)
  // Non-secret 6-char prefix for fast lookup before bcrypt compare
  apiKeyPrefix String   @db.VarChar(10)
  webhookUrl   String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz

  company            Company?            @relation(fields: [companyId], references: [id])
  users              User[]
  events             Event[]
  businessRules      BusinessRule[]
  businessTierConfig BusinessTierConfig?
  businessBadges     BusinessBadge[]
  analyticsSnapshots AppAnalyticsSnapshot[]

  @@index([apiKeyPrefix])
  @@index([companyId])
  @@map("apps")
}

// ─────────────────────────────────────────────────────────────────────────────
// Users — wallet-native identity
// ─────────────────────────────────────────────────────────────────────────────
model User {
  walletAddress       String   @id @db.VarChar(42)
  appId               String   @db.Uuid
  referralCode        String   @unique @db.VarChar(20)
  referredByWallet    String?  @db.VarChar(42)
  currentTier         String   @default("bronze") @db.VarChar(20)
  currentPointsBalance BigInt  @default(0)
  totalPointsEarned   BigInt   @default(0)
  firstSeenAt         DateTime @default(now()) @db.Timestamptz
  lastActiveAt        DateTime @default(now()) @db.Timestamptz

  app              App          @relation(fields: [appId], references: [id])
  referredBy       User?        @relation("ReferralChain", fields: [referredByWallet], references: [walletAddress])
  referrals        User[]       @relation("ReferralChain")
  events           Event[]
  rewards          Reward[]
  ruleTriggers     RuleTrigger[]
  referralsMade    Referral[]   @relation("ReferrerRelation")
  referralReceived Referral?    @relation("RefereeRelation")

  @@index([appId])
  @@index([referralCode])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Events — append-only event log
// ─────────────────────────────────────────────────────────────────────────────
model Event {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletAddress  String    @db.VarChar(42)
  appId          String    @db.Uuid
  eventType      String    @db.VarChar(50)
  // Flexible JSONB metadata — e.g., { amount: 75, currency: "USD" }
  metadata       Json      @default("{}")
  idempotencyKey String?   @unique @db.Uuid
  status         String    @default("pending") @db.VarChar(20)
  processedAt    DateTime? @db.Timestamptz
  timestamp      DateTime  @default(now()) @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz

  user    User     @relation(fields: [walletAddress], references: [walletAddress])
  app     App      @relation(fields: [appId], references: [id])
  rewards Reward[]
  referralQualified Referral? @relation("QualifyingEvent")

  @@index([walletAddress])
  @@index([eventType, walletAddress])
  @@index([timestamp])
  @@index([appId])
  @@map("events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Rewards — all rewards ever issued
// ─────────────────────────────────────────────────────────────────────────────
model Reward {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletAddress  String   @db.VarChar(42)
  rewardType     String   @db.VarChar(20)
  // JSONB: { amount: 100 } for points, { badge_id: "power_buyer" } for badges
  rewardValue    Json
  ruleId         String   @db.VarChar(100)
  eventId        String?  @db.Uuid
  reason         String?  @db.Text
  onChainTxHash  String?  @db.VarChar(66)
  onChainStatus  String?  @db.VarChar(20)
  issuedAt       DateTime @default(now()) @db.Timestamptz

  user         User         @relation(fields: [walletAddress], references: [walletAddress])
  event        Event?       @relation(fields: [eventId], references: [id])
  ruleTrigger  RuleTrigger?

  @@index([walletAddress])
  @@index([eventId])
  @@map("rewards")
}

// ─────────────────────────────────────────────────────────────────────────────
// Rule Triggers — tracks cooldown and max_triggers_per_user
// ─────────────────────────────────────────────────────────────────────────────
model RuleTrigger {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletAddress String   @db.VarChar(42)
  ruleId        String   @db.VarChar(100)
  triggeredAt   DateTime @default(now()) @db.Timestamptz
  rewardId      String?  @unique @db.Uuid

  user   User    @relation(fields: [walletAddress], references: [walletAddress])
  reward Reward? @relation(fields: [rewardId], references: [id])

  @@index([walletAddress, ruleId])
  @@index([triggeredAt])
  @@map("rule_triggers")
}

// ─────────────────────────────────────────────────────────────────────────────
// Referrals — referral chain with fraud status
// ─────────────────────────────────────────────────────────────────────────────
model Referral {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerWallet     String    @db.VarChar(42)
  refereeWallet      String    @unique @db.VarChar(42)
  referralCode       String    @db.VarChar(20)
  status             String    @default("pending") @db.VarChar(20)
  qualifyingEventId  String?   @unique @db.Uuid
  fraudReason        String?   @db.Text
  createdAt          DateTime  @default(now()) @db.Timestamptz
  confirmedAt        DateTime? @db.Timestamptz

  referrer         User   @relation("ReferrerRelation", fields: [referrerWallet], references: [walletAddress])
  referee          User   @relation("RefereeRelation", fields: [refereeWallet], references: [walletAddress])
  qualifyingEvent  Event? @relation("QualifyingEvent", fields: [qualifyingEventId], references: [id])

  @@index([referrerWallet])
  @@index([referralCode])
  @@map("referrals")
}

// ─────────────────────────────────────────────────────────────────────────────
// Badge Definitions — master list of all possible badges
// ─────────────────────────────────────────────────────────────────────────────
model BadgeDefinition {
  badgeId     String   @id @db.VarChar(100)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  imageUrl    String?  @db.Text
  rarity      String   @default("common") @db.VarChar(20)
  createdAt   DateTime @default(now()) @db.Timestamptz

  @@map("badge_definitions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Business Rules — per-business rule configuration (replaces global JSON file)
// ─────────────────────────────────────────────────────────────────────────────
model BusinessRule {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appId         String   @db.Uuid
  ruleId        String   @db.VarChar(100)  // business-defined identifier, unique per app
  name          String   @db.VarChar(255)
  description   String?  @db.Text
  ruleType      String   @db.VarChar(20)   // threshold | frequency | conditional
  triggerEvent  String   @db.VarChar(50)   // event type or '*'
  conditions    Json                        // ConditionGroup JSONB
  rewardConfig  Json                        // RewardConfig JSONB
  priority      Int      @default(10)
  enabled       Boolean  @default(true)
  cooldownHours Int?
  maxTriggers   Int?
  createdAt     DateTime @default(now()) @db.Timestamptz
  updatedAt     DateTime @updatedAt @db.Timestamptz

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, ruleId])
  @@index([appId, enabled])
  @@index([appId, triggerEvent])
  @@map("business_rules")
}

// ─────────────────────────────────────────────────────────────────────────────
// Business Tier Config — per-business tier structure, currency name, spin pools
// ─────────────────────────────────────────────────────────────────────────────
model BusinessTierConfig {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appId        String   @unique @db.Uuid   // one config per business
  currencyName String   @default("points") @db.VarChar(50)  // e.g., "Stars", "XP", "Gems"
  tiers        Json                         // TierConfig[] JSONB
  spinPools    Json     @default("{}")      // Record<string, SpinPoolEntry[]> JSONB
  updatedAt    DateTime @updatedAt @db.Timestamptz

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("business_tier_configs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Business Badge Definitions — per-business badge catalog
// ─────────────────────────────────────────────────────────────────────────────
model BusinessBadge {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appId       String   @db.Uuid
  badgeId     String   @db.VarChar(100)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  imageUrl    String?  @db.Text
  rarity      String   @default("common") @db.VarChar(20)
  createdAt   DateTime @default(now()) @db.Timestamptz

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, badgeId])
  @@index([appId])
  @@map("business_badges")
}

// ─────────────────────────────────────────────────────────────────────────────
// App Analytics Snapshots — daily cached analytics per app
// Avoids expensive COUNT queries on every dashboard load
// ─────────────────────────────────────────────────────────────────────────────
model AppAnalyticsSnapshot {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  appId               String   @db.Uuid
  snapshotDate        DateTime @db.Date              // one row per app per day
  totalUsers          Int      @default(0)
  newUsers            Int      @default(0)
  totalEvents         Int      @default(0)
  totalRewardsIssued  Int      @default(0)
  totalPointsIssued   BigInt   @default(0)
  totalBadgesIssued   Int      @default(0)
  totalReferrals      Int      @default(0)
  topRuleId           String?  @db.VarChar(100)
  topRuleFires        Int      @default(0)
  tierDistribution    Json     @default("{}")        // { bronze: 10, silver: 5, ... }
  createdAt           DateTime @default(now()) @db.Timestamptz

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, snapshotDate])
  @@index([appId])
  @@map("app_analytics_snapshots")
}
